+  auth=patch('accounts.require',return_value={'username':'admin'});auth.start();self.addCleanup(auth.stop)
+ def test_global_off_and_minutes_persist(self):
+  for body in ({'enabled':False,'minutes':10},{'enabled':True,'minutes':27}):
+   response=self.client.post('/api/dynamic-timer',json=body)
+   self.assertEqual(response.status_code,200)
+   saved=json.loads((self.state/'dynamic-timer.json').read_text())
+   self.assertEqual(saved['enabled'],body['enabled']);self.assertEqual(saved['minutes'],body['minutes'])
+   self.assertEqual(self.client.get('/api/dynamic-timer').json()['enabled'],body['enabled'])
+ def test_unsupported_mode_rejected(self):
+  for mode,family in (('allstar','AllStar'),('p25','P25'),('dmr','CBridge')):
